1) Nome dos pacientes que realizaram consulta
SELECT paciente.nome as "PACIENTE"
FROM paciente
INNER JOIN consulta ON paciente.codigoconvenio = consulta.codigoconveniovAND paciente.numeropaciente = consulta.numeropaciente 

2) Nome dos pacientes e dos convênios que realizaram consulta
SELECT paciente.nome as "PACIENTE", convenio.nome as "CONVENIO"
FROM paciente
INNER JOIN consulta ON paciente.codigoconvenio = consulta.codigoconvenio AND paciente.numeropaciente = consulta.numeropaciente
INNER JOIN convenio ON paciente.codigoconvenio = convenio.codigoconvenio AND convenio.codigoconvenio = consulta.codigoconvenio

3) Nome dos pacientes, dos convênios e a data da consulta 
SELECT paciente.nome as "PACIENTE", convenio.nome as "CONVENIO", consulta.datahora as "HORA"
FROM paciente
INNER JOIN consulta ON paciente.codigoconvenio = consulta.codigoconvenio AND paciente.numeropaciente = consulta.numeropaciente
INNER JOIN convenio ON paciente.codigoconvenio = convenio.codigoconvenio AND convenio.codigoconvenio = consulta.codigoconvenio

4) Nome  dos  pacientes,  dos  convênios,  dos  médicos  e  a  data  da consulta
SELECT paciente.nome AS "PACIENTE", medico.nome AS "MEDICO", convenio.nome AS "CONVENIO", consulta.datahora AS "HORA"
FROM paciente
INNER JOIN consulta ON paciente.codigoconvenio = consulta.codigoconvenio AND paciente.numeropaciente = consulta.numeropaciente
INNER JOIN medico ON medico.CRM = consulta.CRM
INNER JOIN convenio ON paciente.codigoconvenio = convenio.codigoconvenio;

5) Nome dos médicos e dos pacientes por ele consultados
SELECT medico.nome as "MEDICO", paciente.nome as "PACIENTE"
FROM medico
LEFT JOIN consulta ON medico.CRM = consulta.CRM
LEFT JOIN paciente ON paciente.codigoconvenio = consulta.codigoconvenio AND paciente.numeropaciente = consulta.numeropaciente
ORDER BY medico.nome

6) Nome dos médicos que ainda não realizaram consultas
SELECT medico.nome as "MEDICO"
FROM medico
LEFT JOIN consulta ON medico.CRM = consulta.CRM
WHERE consulta.CRM IS NULL

7) Nome dos médicos e dos pacientes por ele consultados 
SELECT medico.nome AS "MEDICO", paciente.nome AS "PACIENTE"
FROM paciente
RIGHT JOIN consulta ON paciente.codigoconvenio = consulta.codigoconvenio AND paciente.numeropaciente = consulta.numeropaciente
RIGHT JOIN medico ON consulta.CRM = medico.CRM;

8) Nome dos médicos que ainda não realizaram consultas
SELECT medico.nome as "MEDICO"
FROM medico
RIGHT JOIN consulta ON consulta.CRM = medico.CRM

9) Nome dos médicos que ainda não atenderam pacientes
SELECT medico.nome as 'Médico' 
FROM consulta 
RIGHT JOIN medico on consulta.CRM = medico.CRM 
WHERE consulta.CRM IS null
ORDER by medico.nome;

10) Nome dos pacientes que ainda não tiveram atendimento
SELECT paciente.nome as 'paciente que ainda não teve consulta' 
FROM consulta 
RIGHT JOIN paciente ON consulta.codigoconvenio = paciente.codigoconvenio AND consulta.numeropaciente = paciente.numeropaciente 
WHERE consulta.numeropaciente IS null and consulta.codigoconvenio is null 
ORDER by paciente.nome; 

11) Liste os nomes dos pacientes e os médicos em ordem alfabética
SELECT paciente.nome as "PACIENTE"
FROM paciente
UNION
SELECT medico.nome as "MEDICO"
FROM medico
ORDER BY nome ASC;

12) (IN) Liste os pacientes que foram atendidos pelo convênio 1 e 2
SELECT paciente.nome, paciente.codigoconvenio
FROM paciente
WHERE paciente.codigoconvenio IN (1, 2);

13) (BETWEEN) Liste os pacientes que foram atendidos pelo convênio 1 e 2
SELECT paciente.nome, paciente.codigoconvenio
FROM paciente
WHERE paciente.codigoconvenio BETWEEN '1' AND '5';

14) (LIKE {PATROON}) Nome pacientes que contém o nome “Maria”  
SELECT pacientes.nome
FROM paciente
WHERE nome LIKE "%Maria"

15) (ORDER BY) Trazer o nome dos médicos em ordem decrescente
SELECT medico.nome
FROM medico
ORDER BY medico.nome DESC;

16) (GROUP BY) Trazer o nome dos médicos e o total de consultas que ele realizou
SELECT medico.nome, count(consulta.crm)
FROM medico
INNER JOIN consulta ON medico.CRM = consulta.CRM
GROUP BY consulta.CRM

17) (HAVING) Trazer o nome dos médicos que realizaram mais de uma consulta
SELECT medico.nome
FROM medico
GROUP BY 
HAVING 

18)(HAVING) Trazer o nome dos médicos que mais realizaram consulta
SELECT medico.nome
FROM medico
GROUP BY 
HAVING 